{
	"core": {
		"filesExclude": ["./docs"]
	},
	"coaxial": {
		"worktree": {
			"setup": "ln -s ../../node_modules node_modules"
		}
	},
	"ai": {
		"instructions": [
			"To Build: npm run build package --prefix source",
			"To run tests: npm test --prefix source"
		]
	},
	"watch": {
		"rules": {
			"source": {
				"files": ["source/*"],
				"tasks": "npm run build --prefix source"
			}
		}
	}
}
